ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# How chunks are retrieved: tfidf, semantic or hybrid (default: hybrid).
# tfidf needs no model download. semantic and hybrid download the embedding
# model (about 220 MB) the first time the server starts.
RETRIEVAL_MODE=hybrid

# Qdrant server used by semantic and hybrid retrieval, for example
# http://localhost:6333 after `docker compose up -d`.
# Leave empty to run Qdrant in memory, with nothing to start.
QDRANT_URL=
